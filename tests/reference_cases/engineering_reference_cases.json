  "cases": [
    {
      "id": "UNIT-LENGTH-MM-TO-M-001",
      "operation": "quantity.convert",
      "inputs": {"value": 25.0, "unit": "mm", "target_unit": "m"},
      "expected": 0.025,
      "tolerance": 1e-14,
      "reference": "SI prefix conversion: 1 mm = 1e-3 m"
    },
    {
      "id": "MECH-AXIAL-STRESS-001",
      "operation": "mechanics.axial_stress",
      "inputs": {"force": {"value": 1000.0, "unit": "N"}, "width": {"value": 100.0, "unit": "mm"}, "height": {"value": 100.0, "unit": "mm"}, "unit": "MPa"},
      "expected": 0.1,
      "tolerance": 1e-12,
      "reference": "sigma = F / A"
    },
    {
      "id": "MECH-AXIAL-STRAIN-001",
      "operation": "mechanics.axial_strain",
      "inputs": {"extension": {"value": 1.0, "unit": "mm"}, "length": {"value": 1.0, "unit": "m"}},
      "expected": 0.001,
      "tolerance": 1e-14,
      "reference": "epsilon = delta_L / L"
    },
    {
      "id": "MECH-FACTOR-OF-SAFETY-001",
