      "tolerance": 1e-14,
      "reference": "I = V / R"
    },
    {
      "id": "ELEC-POWER-001",
      "operation": "electrical.power",
      "inputs": {"voltage": {"value": 12.0, "unit": "V"}, "current": {"value": 2.0, "unit": "A"}, "unit": "W"},
      "expected": 24.0,
      "tolerance": 1e-14,
      "reference": "P = V * I"
    },
