{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phakphum12345/universal-platform/schemas/shared/error-envelope.schema.json",
  "title": "Shared API Error Envelope",
  "description": "Additive machine-readable error shape for versioned shared API contracts. Existing domain success payloads and legacy validation formats are not changed.",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "additionalProperties": true
    },
    "request_id": {
      "$ref": "request-id.schema.json"
    }
  },
  "additionalProperties": true
}
