{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ParametricSketch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sketch_id",
    "frame_id",
    "length_unit",
    "points",
    "segments",
    "constraints"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "sketch_id": {
      "type": "string",
      "minLength": 1
    },
    "frame_id": {
      "type": "string",
      "minLength": 1
    },
    "length_unit": {
      "type": "string",
      "minLength": 1
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "point_id",
        "x",
        "y"
      ],
      "properties": {
        "point_id": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "start_point_id",
        "end_point_id"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "minLength": 1
        },
        "start_point_id": {
          "type": "string",
          "minLength": 1
        },
        "end_point_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "kind",
        "point_ids",
        "value",
        "tolerance"
      ],
      "properties": {
        "constraint_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "HORIZONTAL",
            "VERTICAL",
            "COINCIDENT",
            "DISTANCE",
            "HORIZONTAL_DISTANCE",
            "VERTICAL_DISTANCE",
            "FIX_X",
            "FIX_Y"
          ]
        },
        "point_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "tolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "FIX_X",
                  "FIX_Y"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "point_ids": {
                "minItems": 1,
                "maxItems": 1
              },
              "value": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "DISTANCE",
                  "HORIZONTAL_DISTANCE",
                  "VERTICAL_DISTANCE"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "point_ids": {
                "minItems": 2,
                "maxItems": 2
              },
              "value": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "HORIZONTAL",
                  "VERTICAL",
                  "COINCIDENT"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "point_ids": {
                "minItems": 2,
                "maxItems": 2
              },
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
