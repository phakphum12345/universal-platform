{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ParametricSketch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sketch_id",
    "frame_id",
    "length_unit",
    "points",
    "segments",
    "constraints"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ]
    },
    "sketch_id": {
      "type": "string",
      "minLength": 1
    },
    "frame_id": {
      "type": "string",
      "minLength": 1
    },
    "length_unit": {
      "type": "string",
      "minLength": 1
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "arcs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/arc"
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "point_id",
        "x",
        "y"
      ],
      "properties": {
        "point_id": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "start_point_id",
        "end_point_id"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "minLength": 1
        },
        "start_point_id": {
          "type": "string",
          "minLength": 1
        },
        "end_point_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "kind",
        "point_ids",
        "value",
        "tolerance"
      ],
      "properties": {
        "constraint_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "HORIZONTAL",
            "VERTICAL",
            "COINCIDENT",
            "DISTANCE",
            "HORIZONTAL_DISTANCE",
            "VERTICAL_DISTANCE",
            "FIX_X",
            "FIX_Y",
            "PARALLEL",
            "PERPENDICULAR",
            "EQUAL_LENGTH",
            "ANGLE",
            "TANGENT",
            "RADIUS"
          ]
        },
        "point_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "tolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "segment_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "arc_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "FIX_X",
                  "FIX_Y"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "point_ids": {
                "minItems": 1,
                "maxItems": 1
              },
              "value": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "DISTANCE",
                  "HORIZONTAL_DISTANCE",
                  "VERTICAL_DISTANCE"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "point_ids": {
                "minItems": 2,
                "maxItems": 2
              },
              "value": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "HORIZONTAL",
                  "VERTICAL",
                  "COINCIDENT"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "point_ids": {
                "minItems": 2,
                "maxItems": 2
              },
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "PARALLEL",
                  "PERPENDICULAR",
                  "EQUAL_LENGTH"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "point_ids": {
                "minItems": 4,
                "maxItems": 4
              },
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ANGLE"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "segment_ids"
            ],
            "properties": {
              "point_ids": {
                "maxItems": 0
              },
              "segment_ids": {
                "minItems": 2,
                "maxItems": 2
              },
              "value": {
                "type": "number",
                "minimum": -3.141592653589793,
                "maximum": 3.141592653589793
              },
              "arc_ids": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "RADIUS"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "point_ids": {
                "maxItems": 0
              },
              "arc_ids": {
                "minItems": 1,
                "maxItems": 1
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "segment_ids": {
                "maxItems": 0
              }
            },
            "required": [
              "arc_ids"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "TANGENT"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "point_ids": {
                "minItems": 1,
                "maxItems": 1
              },
              "segment_ids": {
                "minItems": 1,
                "maxItems": 1
              },
              "arc_ids": {
                "minItems": 1,
                "maxItems": 1
              },
              "value": {
                "type": "null"
              }
            },
            "required": [
              "segment_ids",
              "arc_ids"
            ]
          }
        }
      ]
    },
    "arc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arc_id",
        "center_point_id",
        "start_point_id",
        "end_point_id",
        "clockwise"
      ],
      "properties": {
        "arc_id": {
          "type": "string",
          "minLength": 1
        },
        "center_point_id": {
          "type": "string",
          "minLength": 1
        },
        "start_point_id": {
          "type": "string",
          "minLength": 1
        },
        "end_point_id": {
          "type": "string",
          "minLength": 1
        },
        "clockwise": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "constraints": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "properties": {
                      "kind": {
                        "const": "ANGLE",
                        "enum": [
                          "ANGLE",
                          "TANGENT",
                          "RADIUS"
                        ]
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  {
                    "required": [
                      "segment_ids"
                    ]
                  },
                  {
                    "required": [
                      "arc_ids"
                    ]
                  }
                ]
              }
            }
          }
        },
        "not": {
          "required": [
            "arcs"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "constraints": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "properties": {
                      "kind": {
                        "enum": [
                          "TANGENT",
                          "RADIUS"
                        ]
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  {
                    "required": [
                      "arc_ids"
                    ]
                  }
                ]
              }
            }
          }
        },
        "not": {
          "required": [
            "arcs"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.2"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "arcs"
        ]
      }
    }
  ]
}
