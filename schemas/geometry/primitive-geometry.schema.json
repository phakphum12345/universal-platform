{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"CAD-neutral Primitive Geometry Model","type":"object","additionalProperties":false,
  "required":["schema_version","frame_graph","solids"],
  "properties":{"schema_version":{"const":"1.0"},
    "frame_graph":{"$ref":"../geometry/coordinate-frame-graph.schema.json"},
    "solids":{"type":"array","items":{"oneOf":[{"$ref":"#/$defs/box"},{"$ref":"#/$defs/cylinder"}]}}},
  "$defs":{
    "box":{"type":"object","additionalProperties":false,"required":["kind","solid_id","frame_id","dimensions"],
      "properties":{"kind":{"const":"BOX"},"solid_id":{"type":"string","minLength":1},"frame_id":{"type":"string","minLength":1},
        "dimensions":{"type":"object","additionalProperties":false,"required":["x","y","z","unit"],
          "properties":{"x":{"type":"number","exclusiveMinimum":0},"y":{"type":"number","exclusiveMinimum":0},
            "z":{"type":"number","exclusiveMinimum":0},"unit":{"enum":["m","mm","cm","km","in"]}}}}},
    "cylinder":{"type":"object","additionalProperties":false,"required":["kind","solid_id","frame_id","radius","height","unit"],
      "properties":{"kind":{"const":"CYLINDER"},"solid_id":{"type":"string","minLength":1},"frame_id":{"type":"string","minLength":1},
        "radius":{"type":"number","exclusiveMinimum":0},"height":{"type":"number","exclusiveMinimum":0},
        "unit":{"enum":["m","mm","cm","km","in"]}}}
  }
}