{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAD-neutral Primitive Geometry Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "frame_graph",
    "solids"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.0", "1.1"]
    },
    "frame_graph": {
      "$ref": "coordinate-frame-graph.schema.json"
    },
    "solids": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/box"
          },
          {
            "$ref": "#/$defs/cylinder"
          },
          {
            "$ref": "#/$defs/extrudedProfile"
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.0"}}, "required": ["schema_version"]},
      "then": {
        "properties": {
          "solids": {
            "items": {
              "not": {"anyOf": [{"required": ["arc_sweeps_rad"]}, {"required": ["hole_arc_sweeps_rad"]}]}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "solid_id",
        "frame_id",
        "dimensions"
      ],
      "properties": {
        "kind": {
          "const": "BOX"
        },
        "solid_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z",
            "unit"
          ],
          "properties": {
            "x": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "y": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "z": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "enum": [
                "m",
                "mm",
                "cm",
                "km",
                "in"
              ]
            }
          }
        }
      }
    },
    "cylinder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "solid_id",
        "frame_id",
        "radius",
        "height",
        "unit"
      ],
      "properties": {
        "kind": {
          "const": "CYLINDER"
        },
        "solid_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "m",
            "mm",
            "cm",
            "km",
            "in"
          ]
        }
      }
    },
    "profilePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "extrudedProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "solid_id",
        "frame_id",
        "profile",
        "height",
        "unit"
      ],
      "properties": {
        "kind": {
          "const": "EXTRUDED_PROFILE"
        },
        "solid_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/profilePoint"
          }
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "m",
            "mm",
            "cm",
            "km",
            "in"
          ]
        },
        "holes": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 3,
            "items": {
              "$ref": "#/$defs/profilePoint"
            }
          }
        },
        "arc_sweeps_rad": {"type": "array", "minItems": 3, "items": {"type": "number"}},
        "segment_ids": {"type": "array", "minItems": 3, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$"}},
        "hole_arc_sweeps_rad": {"type": "array", "items": {"type": "array", "minItems": 3, "items": {"type": "number"}}},
        "hole_segment_ids": {"type": "array", "items": {"type": "array", "minItems": 3, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$"}}}
      }
    }
  }
}
