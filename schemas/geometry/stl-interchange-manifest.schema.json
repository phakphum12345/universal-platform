{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STLInterchangeManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "format",
    "coordinate_encoding",
    "normal_policy",
    "solid_id",
    "source_kind",
    "source_mesh_schema_version",
    "source_geometry_sha256",
    "frame_id",
    "length_unit",
    "chordal_tolerance",
    "stl_byte_length",
    "facet_count",
    "stl_sha256",
    "max_coordinate_rounding_error"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "format": {"const": "BINARY_STL"},
    "coordinate_encoding": {"const": "IEEE754_BINARY32_LE"},
    "normal_policy": {"const": "RECOMPUTED_FROM_QUANTIZED_FACETS"},
    "solid_id": {"type": "string", "minLength": 1},
    "source_kind": {"enum": ["BOX", "CYLINDER", "EXTRUDED_PROFILE"]},
    "source_mesh_schema_version": {"const": "1.0"},
    "source_geometry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "frame_id": {"type": "string", "minLength": 1},
    "length_unit": {"type": "string", "minLength": 1},
    "chordal_tolerance": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "stl_byte_length": {"type": "integer", "minimum": 284},
    "facet_count": {"type": "integer", "minimum": 4, "maximum": 1000000},
    "stl_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "max_coordinate_rounding_error": {"type": "number", "minimum": 0}
  }
}