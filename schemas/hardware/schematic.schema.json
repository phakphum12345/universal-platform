{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Hardware Schematic Netlist","type":"object","additionalProperties":false,
  "required":["schema_version","components","nets"],
  "properties":{"schema_version":{"const":"1.0"},"components":{"type":"array","items":{"$ref":"#/$defs/component"}},"nets":{"type":"array","items":{"$ref":"#/$defs/net"}}},
  "$defs":{
    "pin":{"type":"object","additionalProperties":false,"required":["pin_id","number","name","electrical_type"],
      "properties":{"pin_id":{"type":"string","minLength":1},"number":{"type":"string","minLength":1},"name":{"type":"string","minLength":1},
      "electrical_type":{"enum":["PASSIVE","INPUT","OUTPUT","BIDIRECTIONAL","POWER_IN","POWER_OUT","OPEN_DRAIN","OPEN_COLLECTOR","NO_CONNECT"]}}},
    "component":{"type":"object","additionalProperties":false,"required":["component_id","reference_designator","symbol_id","pins","value","manufacturer_part"],
      "properties":{"component_id":{"type":"string","minLength":1},"reference_designator":{"type":"string","pattern":"^[A-Z]{1,4}[0-9]+$"},
      "symbol_id":{"type":"string","minLength":1},"pins":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/pin"}},
      "value":{"type":["string","null"]},"manufacturer_part":{"type":["string","null"]}}},
    "pinRef":{"type":"object","additionalProperties":false,"required":["component_id","pin_id"],
      "properties":{"component_id":{"type":"string","minLength":1},"pin_id":{"type":"string","minLength":1}}},
    "net":{"type":"object","additionalProperties":false,"required":["net_id","name","terminals"],
      "properties":{"net_id":{"type":"string","minLength":1},"name":{"type":["string","null"]},
      "terminals":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/pinRef"}}}}
  }
}