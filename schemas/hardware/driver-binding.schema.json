{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Hardware Driver Binding Model","type":"object","additionalProperties":false,
  "required":["schema_version","interfaces","bindings"],
  "properties":{"schema_version":{"const":"1.0"},"interfaces":{"type":"array","items":{"$ref":"#/$defs/interface"}},
    "bindings":{"type":"array","items":{"$ref":"#/$defs/binding"}}},
  "$defs":{
    "signal":{"type":"object","additionalProperties":false,"required":["signal_id","name","direction"],
      "properties":{"signal_id":{"type":"string","minLength":1},"name":{"type":"string","minLength":1},
        "direction":{"enum":["INPUT","OUTPUT","BIDIRECTIONAL","POWER_IN","POWER_OUT","OPEN_DRAIN","OPEN_COLLECTOR"]}}},
    "interface":{"type":"object","additionalProperties":false,
      "required":["driver_id","module_id","operation_id","protocol","version","signals"],
      "properties":{"driver_id":{"type":"string","minLength":1},"module_id":{"type":"string","minLength":1},
        "operation_id":{"type":"string","minLength":1},"protocol":{"enum":["GPIO","I2C","SPI","UART","CAN","USB","PCIE","PWM","ADC","DAC","GENERIC"]},
        "version":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "signals":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/signal"}}}},
    "binding":{"type":"object","additionalProperties":false,
      "required":["binding_id","component_id","pin_id","driver_id","signal_id"],
      "properties":{"binding_id":{"type":"string","minLength":1},"component_id":{"type":"string","minLength":1},
        "pin_id":{"type":"string","minLength":1},"driver_id":{"type":"string","minLength":1},"signal_id":{"type":"string","minLength":1}}}
  }
}